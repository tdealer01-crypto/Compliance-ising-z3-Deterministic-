# Android client build configuration. 10.0.2.2 reaches the host from an Android emulator.
ANDROID_DSG_BACKEND_BASE_URL=http://10.0.2.2:8000/
# Development only. Do not embed a long-lived production secret in an APK.
ANDROID_DSG_BACKEND_API_KEY=

# Backend runtime configuration used by docker compose or a hosted deployment.
DSG_API_KEY=
PROOF_SIGNING_SECRET=replace-with-a-random-secret
AUDIT_DB_PATH=/data/dsg_audit.sqlite3
