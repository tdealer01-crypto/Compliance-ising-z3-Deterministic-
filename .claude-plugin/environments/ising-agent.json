{
  "name": "ising-agent",
  "description": "DSG Android QUBO client with server-side Z3 verification and MCP backend.",
  "build": {
    "command": "python",
    "args": [
      "-m",
      "pip",
      "install",
      "-e",
      "backend[dev]"
    ]
  },
  "test": {
    "command": "python",
    "args": [
      "-m",
      "pytest",
      "backend/tests"
    ]
  },
  "strict": true
}
